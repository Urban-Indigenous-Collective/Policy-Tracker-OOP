# App secrets
LEGISCAN_KEY=

# LLM provider (Ollama, vLLM, OpenAI-compatible)
# Use UIC production Ollama when running scripts from a Mac (local Ollama lacks Qwen).
LLM_BASE_URL=http://100.71.124.8:11434/v1
LLM_MODEL=qwen2.5vl:32b
LLM_API_KEY=ollama
LLM_TEMPERATURE=0
LLM_SEED=42
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=cache

# Legacy aliases (still supported)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5vl:32b

# Optional shared inference gateway (Phase 7 — set to enable cross-app queue)
# LLM_GATEWAY_URL=http://inference-gateway:8090

# Airtable (duplicate checking + pending workflow)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE="Main v3"
AIRTABLE_PENDING_TABLE=Pending

# Slack notifications
SLACK_WEBHOOK_URL=
SLACK_QUIET_RUNS=true

# Nightly pipeline (discovery → status refresh → validation refresh)
NIGHTLY_PIPELINE_CRON=0 2 * * *
# DISCOVERY_CRON is a deprecated alias for NIGHTLY_PIPELINE_CRON
DISCOVERY_ENABLED=true
STATUS_REFRESH_ENABLED=true
DISCOVERY_TZ=America/New_York
APPROVAL_SYNC_INTERVAL_MIN=10
DISCOVERY_DB_PATH=data/discovery.db
DISCOVERY_LEGISCAN_YEAR=2
DISCOVERY_RELEVANCE_MIN_CONFIDENCE=0.6
DISCOVERY_MAX_ANALYSES_PER_RUN=25
CRAWLER_USER_AGENT=UIC-PolicyTracker/1.0 (+https://urbanindigenouscollective.org)

# Pending validation refresh (pipeline step 3; disabled until manually enabled)
VALIDATION_REFRESH_ENABLED=false
VALIDATION_REFRESH_APPLY_EVAL_EXPL_FIXES=false

# Indigenous politician roster cache (weekly Wikipedia refresh; disabled by default)
INDIGENOUS_DB_REFRESH_ENABLED=false
INDIGENOUS_DB_REFRESH_CRON=0 1 * * 0
INDIGENOUS_DB_MIN_COUNT=500

# Post-refresh Wikipedia ethnicity enrichment (runs after roster refresh/dedupe)
INDIGENOUS_ETHNICITY_ENRICH_ON_REFRESH=true
INDIGENOUS_ETHNICITY_LLM_FALLBACK_ON_REFRESH=false

# Manual-only ethnicity enrichment CLI (scripts/enrich_indigenous_ethnicity.py)
INDIGENOUS_ETHNICITY_ENRICH_ENABLED=false
INDIGENOUS_ETHNICITY_ENRICH_CRON=0 2 * * 0
INDIGENOUS_ETHNICITY_CACHE_DAYS=30

# Local development only
FLASK_DEBUG=0

# Deploy defaults (manual deploy / server)
DEPLOY_HOST=100.71.124.8
DEPLOY_USER=info@urbanindigenouscollective.org
DEPLOY_PATH=C:/Users/info/policy-tracker
WSL_DEPLOY_PATH=/opt/policy-tracker
POLICY_HOST_PORT=8002
