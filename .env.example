# App secrets
LEGISCAN_KEY=

# LLM provider (Ollama, vLLM, OpenAI-compatible)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5vl:32b
LLM_API_KEY=ollama
LLM_TEMPERATURE=0
LLM_SEED=42
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=cache

# Legacy aliases (still supported)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5vl:32b

# Optional shared inference gateway (Phase 7 — set to enable cross-app queue)
# LLM_GATEWAY_URL=http://inference-gateway:8090

# Airtable (duplicate checking)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE="Main v3"

# Local development only
FLASK_DEBUG=0

# Deploy defaults (manual deploy / server)
DEPLOY_HOST=100.71.124.8
DEPLOY_USER=info@urbanindigenouscollective.org
DEPLOY_PATH=C:/Users/info/policy-tracker
WSL_DEPLOY_PATH=/opt/policy-tracker
POLICY_HOST_PORT=8002
